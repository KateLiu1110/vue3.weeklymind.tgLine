{
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 9 * * *",
      "method": "POST",
      "headers": {
        "x-cron-secret": "replace-with-your-cron-secret"
      },
      "body": {
        "kind": "daily"
      }
    },
    {
      "path": "/api/cron",
      "schedule": "0 21 * * 0",
      "method": "POST",
      "headers": {
        "x-cron-secret": "replace-with-your-cron-secret"
      },
      "body": {
        "kind": "weekly"
      }
    }
  ]
}
