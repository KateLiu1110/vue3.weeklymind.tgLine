# Local dev: `docker compose up -d` at the repo root starts this Postgres.
DATABASE_URL="postgresql://weeklymind:weeklymind@localhost:5434/weeklymind"
PORT=4000
JWT_SECRET="change-me-in-production"

# LINE Messaging API — see api-architecture.md §2.1/2.5 and LOGIN_操作手冊.md
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# LIFF QR Code 登入用（尚未申請，見 api-architecture.md §2.1 方式二）
LIFF_ID=

# LINE Login（一般「使用 LINE 帳號登入」按鈕，見 api-architecture.md §2.1 方式一之二）
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_REDIRECT_URI="http://localhost:4000/api/auth/line/callback"
FRONTEND_ORIGIN="http://localhost:5173"

# 每日推播提醒排程（cron 語法，預設每天 08:00 台北時間）
DAILY_CHECKIN_CRON="0 8 * * *"
DAILY_CHECKIN_TIMEZONE="Asia/Taipei"
